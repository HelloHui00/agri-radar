{
  "llm": {
    "provider": "deepseek",
    "base_url": "https://api.deepseek.com/v1",
    "model": "deepseek-chat",
    "api_key_env": "LLM_API_KEY"
  },
  "feishu": {
    "webhook_url": "https://open.feishu.cn/open-apis/bot/v2/hook/YOUR-WEBHOOK-HERE",
    "secret": "YOUR-SECRET-HERE",
    "enable_feedback_buttons": true
  },
  "proxy": {
    "enabled": false,
    "http_proxy": "",
    "https_proxy": ""
  },
  "push": {
    "channels": [
      "feishu"
    ],
    "brief_save_to_file": true,
    "brief_output_dir": "output"
  }
}